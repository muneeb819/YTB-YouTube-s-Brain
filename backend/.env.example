# Copy to .env and adjust. Never commit .env.
YTB_SECRET_KEY=change-me-in-production
YTB_ADMIN_EMAIL=admin@example.com
YTB_ADMIN_PASSWORD=change-me-in-production

YTB_HOST=0.0.0.0
YTB_PORT=8000
YTB_DATABASE_URL=sqlite:///./data/ytb.db
YTB_STORAGE_DIR=./workspace

# Local/offline AI (default)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional cloud AI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Allowlist origins, comma-separated, or * for development.
# Vite dev server is http://localhost:5173. The vite/nginx proxy makes `/api`
# same-origin, so CORS is only needed for direct cross-origin browser calls.
CORS_ORIGINS=*
MAX_UPLOAD_BYTES=4294967296